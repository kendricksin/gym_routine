# Lark App credentials (from https://open.larksuite.com/app → your app → Credentials)
LARK_APP_ID=cli_xxxxxxxxxxxx
LARK_APP_SECRET=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Lark Base app token (from Base URL: https://xxx.larksuite.com/base/<APP_TOKEN>)
LARK_APP_TOKEN=GpxxxxxxxxxxxxxxxxxxxxxxxxxxxBc

# Test table ID (from Base URL when table is selected: ?table=<TABLE_ID>)
LARK_TEST_TABLE_ID=tblxxxxxxxxxxxxxxxxxx
